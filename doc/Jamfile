import webcpp ;

webcpp.doc trystero : trystero.adoc ;

# No single target builds every header: a page's header builds only on
# emscripten, whose own headers hold only for wasm32's types, so the
# reference reads every header for Emscripten's target, as em++ compiles
# (/webcpp//emscripten-reference), with the platform backend's target, built
# natively, which brings webcpp::webrtc, webcpp::beast, Boost.URL,
# libdatachannel and OpenSSL. The platform backend's Asio and Beast are
# webcpp::asio and webcpp::beast, their browser implementations there, so it
# parses with no configuration of Boost.Asio's (measured: the page builds
# without BOOST_ASIO_DISABLE_THREADS, which Boost.Beast over Boost.Asio
# needed). The rooms' AES-GCM there is BearSSL, Emscripten's default, rather
# than the native default's OpenSSL, which webcpp::crypto refuses on
# Emscripten's target (<webcpp-trystero-reference>on, build.jam).
webcpp.reference trystero : <library>/webcpp/trystero//platform <threading>multi
  <library>/webcpp//emscripten-reference <webcpp-trystero-reference>on ;
