import webcpp ;

webcpp.doc trystero : trystero.adoc ;

# No single target builds every header: the reference parses them natively
# with the native backend's target, which brings libdatachannel and OpenSSL,
# and with Emscripten's own headers, searched after the host's, for the
# browser backend's.
webcpp.reference trystero : <library>/webcpp/trystero//native <library>/webcpp//emscripten-headers ;
