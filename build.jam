#
# trystero, serverless WebRTC rooms, wire compatible with Trystero. A program
# uses /webcpp/trystero//platform, the rooms and the platform backend, on
# both targets; /webcpp/trystero//trystero is the rooms alone, over a backend
# of the program's own, as the tests' memory relays are.

project /webcpp/trystero ;

# Only libsecp256k1 is externally installed. WebRTC is webcpp::webrtc's, whose
# native libdatachannel and its OpenSSL are pinned source dependencies, built
# together for the consumer's B2 variant.
import errors ;
import webcpp ;

# tag::dependencies[]
local secp256k1-root = [ webcpp.external trystero : libsecp256k1
    : SECP256K1_ROOT : secp256k1-native : secp256k1.h : native ] ;
local secp256k1-emscripten-root = [ webcpp.external trystero : libsecp256k1
    : SECP256K1_EMSCRIPTEN_ROOT : secp256k1-emscripten : secp256k1.h : emscripten ] ;
lib secp256k1 : : <name>secp256k1 <toolset>emscripten
    <search>$(secp256k1-emscripten-root)/lib
  : : <include>$(secp256k1-emscripten-root)/include ;
lib secp256k1 : : <name>libsecp256k1 <toolset>msvc
    <search>$(secp256k1-root)/lib
  : : <include>$(secp256k1-root)/include <define>SECP256K1_STATIC ;
lib secp256k1 : : <name>secp256k1 <search>$(secp256k1-root)/lib
  : : <include>$(secp256k1-root)/include ;
# Searched libraries are used only through usage requirements.
explicit secp256k1 ;
# end::dependencies[]

# The dependencies of the rooms: libsecp256k1, the emscripten build of it on
# emscripten. Checked only when a target that uses trystero is built.
rule trystero-dependencies ( properties * )
{
    return [ webcpp.external-found trystero : libsecp256k1 : $(properties) ] ;
}

# The platform backend's own dependencies, checked only when a target that
# uses it is built: natively its WebRTC, libdatachannel's through
# webcpp::webrtc, runs on worker threads.
rule platform-dependencies ( properties * )
{
    if <threading>single in $(properties) && ! <toolset>emscripten in $(properties)
    {
        errors.user-error "Trystero's platform backend uses worker threads natively. Add <threading>multi to the consuming target or pass threading=multi." ;
    }
}

# The rooms: Asio is webcpp::asio, natively Boost.Asio itself, on emscripten
# the shipped backend, without threads (main runs it), which links embind.
# tag::trystero[]
alias trystero : : <conditional>@trystero-dependencies
  : : <include>include <library>/boost//headers <library>/webcpp//boost_json
  <library>/webcpp/config//config <library>/webcpp/asio//asio <library>secp256k1 ;
# end::trystero[]

# The platform backend, one for both targets: its WebRTC is webcpp::webrtc's,
# its relays' WebSockets webcpp::beast's, their URLs read with Boost.URL,
# built from Boost's sources once per variant. Natively webcpp::webrtc brings
# the pinned libdatachannel and OpenSSL, and works with exceptions on and
# off, through libdatachannel's C API; so does the backend. Its relays run
# over the same OpenSSL (//tls), and webcpp::asio's //tls adds webcpp's
# embedded authorities, which a program may trust in place of the system's
# (make_tls_client_context). On emscripten webcpp::webrtc and webcpp::beast
# bind the page's RTCPeerConnection and WebSocket (//browser), and no
# OpenSSL is linked.
# tag::platform[]
alias platform : : <toolset>emscripten
  : : <library>trystero <library>/webcpp/webrtc//webrtc
  <library>/webcpp/beast//browser <library>/webcpp//boost_url ;
alias platform : : <conditional>@platform-dependencies
  : : <library>trystero <library>/webcpp/webrtc//webrtc
  <library>/webcpp/beast//tls <library>/webcpp/asio//tls
  <library>/webcpp//boost_url ;
# end::platform[]
