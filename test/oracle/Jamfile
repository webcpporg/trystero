# The oracle of trystero: Trystero 0.26.0 itself, pinned by package.json and
# package-lock.json, run by Node. It computes the protocol's values that the
# protocol test must reproduce, runs the twins of the examples, and meets the
# C++ peers in the interop tests. werift, pinned beside it, is the WebRTC the
# twins give Trystero JS in Node, as its README says to.

import webcpp ;

webcpp.targets native emscripten ;

# The twins of the examples run under run_twin.mjs, which gives each a relay of
# its own on 127.0.0.1 (twins/without-twin.txt names the programs that have
# none, with the reason).
path-constant ORACLE : . ;

# tag::oracle[]
webcpp.original node --conditions=development ;
webcpp.twins ../../example : twins : .mjs : $(ORACLE)/run_twin.mjs ;
webcpp.cases protocol : oracle.mjs : ../fixtures/cases : ../fixtures/expected ;
webcpp.lane oracle : twins cases-protocol ;
# end::oracle[]

# Trystero JS meets each C++ peer over a relay of its own on 127.0.0.1: the
# browser's peer in headless Chrome, and the native peer as a process, both
# over the platform backend. The native peer is built with the standard
# libraries' own checks, so that a completion that touches a container its
# socket cleared fails at once. Each driver has
# 2400 s for its bounded scenarios and Chrome's start, including the
# wrong-password observation windows and transient-handshake recovery. The
# scenarios report their peer events on failure before this outer bound.
# tag::interop[]
webcpp.drive interop_browser : interop/peer.cpp
  : <library>/webcpp/trystero//platform <linkflags>-sENVIRONMENT=web
    <linkflags>-sALLOW_MEMORY_GROWTH <webcpp-drive-timeout>2400
  : interop/run.mjs : --browser : emscripten ;
webcpp.drive interop_native : interop/native_peer.cpp
  : <library>/webcpp/trystero//platform <threading>multi <webcpp-drive-timeout>2400
    <define>_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE
    <define>_GLIBCXX_ASSERTIONS
  : interop/run.mjs : --native : native ;
webcpp.lane interop : interop_browser interop_native : native emscripten ;
# end::interop[]

# On the branch port/trystero-0.27 the oracle and interop lanes are off until
# Phase 2's Task 2.6: their oracle is still Trystero 0.26.0, whose wire the
# branch no longer speaks. Their targets stay explicit (webcpp.lane makes each
# so), so that the library's test and example directories never build them;
# they run only by name.
explicit twins cases-protocol interop_browser interop_native ;
