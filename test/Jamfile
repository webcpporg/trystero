# MSVC deprecates std::getenv, which room_test.cpp reads, for a getenv_s of
# its own (C4996), an error under /WX: the tests keep the standard's. A test
# of rooms over Asio holds more sections than MSVC's object format allows by
# default (C1128, measured in room, and in platform_websocket,
# platform_peer_connection and platform_room when they were native_*):
# /bigobj.
project : requirements <library>/webcpp/trystero//trystero
  <toolset>msvc:<define>_CRT_SECURE_NO_WARNINGS <toolset>msvc:<cxxflags>/bigobj ;

import webcpp ;

webcpp.targets native emscripten ;

# Natively the platform backend needs worker threads, libdatachannel's; a
# page has none.
rule native-threads ( properties * )
{
    if ! <toolset>emscripten in $(properties)
    {
        return <threading>multi ;
    }
}
local platform = <library>/webcpp/trystero//platform <conditional>@native-threads ;

# The headers that build on both targets: the core, and the platform backend
# with its WebRTC over webcpp::webrtc, natively against libdatachannel and
# OpenSSL, in a page over its own objects; and a page's own header, which
# builds only on emscripten. Every one compiles with exceptions and without
# them, as the build asks, so the lint analyses them so too.
webcpp.headers-alone trystero : ../include
  : trystero.hpp trystero/*.hpp trystero/protocol/*.hpp trystero/detail/*.hpp ;
webcpp.headers-alone trystero : ../include
  : trystero/platform/backend.hpp trystero/platform/entropy.hpp
    trystero/platform/sealer.hpp trystero/platform/websocket.hpp trystero/webrtc/*.hpp
  : $(platform) ;
webcpp.headers-alone trystero : ../include : trystero/platform/page.hpp
  : $(platform) : emscripten ;

# config.hpp defines WEBCPP_TRYSTERO_NO_EXCEPTIONS exactly when webcpp has no
# exceptions, and keeps it when a developer defines it in a build that has
# them.
webcpp.compile config : config_test.cpp ;
webcpp.compile config_developer_defined : config_test.cpp
  : <define>WEBCPP_TRYSTERO_NO_EXCEPTIONS <define>WEBCPP_TEST_TRYSTERO_DEVELOPER_DEFINED ;
# WEBCPP_NO_EXCEPTIONS, which a developer defines for every webcpp library at
# once, defines WEBCPP_TRYSTERO_NO_EXCEPTIONS in a build that has exceptions.
webcpp.compile config_all_off : config_test.cpp
  : <define>WEBCPP_NO_EXCEPTIONS <define>WEBCPP_TEST_TRYSTERO_ALL_OFF ;

# The protocol against what Trystero JS computed, which the original's oracle
# wrote into fixtures/expected/expected.json, and whole rooms over the memory
# backend of support/memory_backend.hpp: on both targets.
# tag::both-targets[]
webcpp.run protocol : protocol_test.cpp : <testing.input-file>fixtures/expected/expected.json ;
# The signaling and the Nostr strategy alone: an answerer's signals against
# Trystero's, and the bounds of the texts they read.
webcpp.run signaling : signaling_test.cpp
  : <testing.input-file>fixtures/expected/expected.json ;
webcpp.run room : room_test.cpp ;
# Rooms of one app that share one connection per remote peer; once as the
# build asks, once without exceptions, on both targets; and, natively, once
# with the standard libraries' checks, so that a kept frame that kicks during
# a binding, or a waiter failed during a connection's end, fails at once when
# it touches what it removed.
webcpp.run shared : shared_test.cpp ;
webcpp.run shared_no_exceptions : shared_test.cpp : <exception-handling>off ;
webcpp.run shared_hardened : shared_test.cpp
  : <define>_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE <define>_GLIBCXX_ASSERTIONS
  : native ;
# The memory backend's hooks, which the tests of shared connections drive.
webcpp.run memory_backend : memory_backend_test.cpp ;
# The shared connection alone, over a memory pair.
webcpp.run connection : connection_test.cpp ;
# The state an app and its rooms share, alone, over the memory backend.
webcpp.run app_impl : app_impl_test.cpp ;
# The timer over webcpp::asio's steady_timer, which the platform backend
# makes: a wait cancelled, restarted or destroyed never fires.
webcpp.run timer : timer_test.cpp ;
# end::both-targets[]

# The platform backend's own tests, on each target that builds them. On both:
# the backend itself (its own state in backend_config::memory, its clocks,
# its randomness, its TLS context); its sealer, natively OpenSSL's AES-GCM, in
# a page Web Crypto under node, against what Trystero JS sealed; relays it
# cannot reach; and how a relay's URL is read. Natively, against
# libdatachannel and in-process servers: the relays' WebSocket, built with the
# standard libraries' own checks, libc++'s extensive hardening and
# libstdc++'s assertions, so that a completion that touches a container its
# socket cleared fails at once, not one run in many; what a relay's message
# allocates outside the room's resource, none; the backend's WebRTC; and whole
# rooms over it. Each as the build asks and,
# but the WebSocket's, which runs once with those checks, without exceptions
# too: webcpp::webrtc calls libdatachannel's C API, which catches what
# libdatachannel throws, so the backend needs none.
# tag::platform[]
webcpp.run platform_backend : platform_backend_test.cpp : $(platform) ;
webcpp.run platform_sealer : platform_sealer_test.cpp
  : $(platform) <testing.input-file>fixtures/expected/expected.json ;
webcpp.run platform_websocket_unreachable : platform_websocket_unreachable_test.cpp
  : $(platform) ;
webcpp.run platform_websocket_url : platform_websocket_url_test.cpp : $(platform) ;
webcpp.run platform_websocket : platform_websocket_test.cpp
  : $(platform) <define>_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE
    <define>_GLIBCXX_ASSERTIONS
  : native ;
webcpp.run platform_websocket_allocation : platform_websocket_allocation_test.cpp
  : $(platform) : native ;
webcpp.run platform_peer_connection : platform_peer_connection_test.cpp
  : $(platform) : native ;
webcpp.run platform_room : platform_room_test.cpp : $(platform) : native ;
webcpp.run platform_backend_no_exceptions : platform_backend_test.cpp
  : $(platform) <exception-handling>off ;
webcpp.run platform_sealer_no_exceptions : platform_sealer_test.cpp
  : $(platform) <testing.input-file>fixtures/expected/expected.json <exception-handling>off ;
webcpp.run platform_websocket_unreachable_no_exceptions : platform_websocket_unreachable_test.cpp
  : $(platform) <exception-handling>off ;
webcpp.run platform_websocket_url_no_exceptions : platform_websocket_url_test.cpp
  : $(platform) <exception-handling>off ;
webcpp.run platform_websocket_allocation_no_exceptions : platform_websocket_allocation_test.cpp
  : $(platform) <exception-handling>off : native ;
webcpp.run platform_peer_connection_no_exceptions : platform_peer_connection_test.cpp
  : $(platform) <exception-handling>off : native ;
webcpp.run platform_room_no_exceptions : platform_room_test.cpp
  : $(platform) <exception-handling>off : native ;
# end::platform[]

# Every allocation of two rooms that exchange a payload goes through the
# resources of their configurations, but webcpp::document's working state
# while it reads or writes a JSON text, which the global operator new sees,
# none of it left once the call returns; the C library's allocation functions
# see none. Its two counting resources hold 64 MiB each, beyond Emscripten's
# 16 MiB unless the memory grows.
# tag::allocation[]
webcpp.run allocation : allocation_test.cpp : <toolset>emscripten:<linkflags>-sALLOW_MEMORY_GROWTH ;
# end::allocation[]

# The platform backend in a page, under node, which has the page's WebSocket
# and Web Crypto but no WebRTC: stand-ins for the page's objects where a test
# needs them. Each main runs its io_context, as a page's program does, and
# suspends in it in either variant.
# tag::page[]
webcpp.run platform_page_websocket_bound : platform_page_websocket_bound_test.cpp
  : $(platform) : emscripten ;
webcpp.run platform_page_websocket_late_events : platform_page_websocket_late_events_test.cpp
  : $(platform) : emscripten ;
# What a relay sends: a text past the bound in the task of its open is
# refused, and a binary message dropped; and the TLS contexts a page honours,
# and those it refuses.
webcpp.run platform_page_websocket_ingress : platform_page_websocket_ingress_test.cpp
  : $(platform) : emscripten ;
webcpp.run platform_page_websocket_tls : platform_page_websocket_tls_test.cpp
  : $(platform) : emscripten ;
webcpp.run platform_page_data_channel : platform_page_data_channel_test.cpp
  : $(platform) : emscripten ;
webcpp.run platform_page_peer_connection : platform_page_peer_connection_test.cpp
  : $(platform) : emscripten ;
# A page's program: main runs the io_context under a work guard, and the
# page's calls into C++ only post to it.
webcpp.run platform_page : platform_page_test.cpp : $(platform) : emscripten ;
# A page's sealer allocates nothing outside the room's resource from the
# start of a seal or an open to its completion: the global operator new and
# the C library's allocation functions, replaced, count none.
webcpp.run platform_page_sealer_allocation : platform_page_sealer_allocation_test.cpp
  : $(platform) : emscripten ;
# A relay's connection and each of its messages allocate outside the room's
# resource exactly what the guide lists, no more and no fewer.
webcpp.run platform_page_relay_allocation : platform_page_relay_allocation_test.cpp
  : $(platform) : emscripten ;
# A page whose crypto misbehaves: its randomness and its sealer fail with
# their errors, and no JavaScript exception enters WebAssembly.
webcpp.run platform_page_sealer : platform_page_sealer_test.cpp : $(platform) : emscripten ;
# A page_call's handler sees the page's value as it is when it runs; a
# function the page kept reaches nothing once its page_call, or its
# io_context, is destroyed; and a page_call outlives its io_context harmlessly.
webcpp.run platform_page_call : platform_page_call_test.cpp : $(platform) : emscripten ;
# A relay socket's handlers and a sealer's completions run outside the page's
# events.
webcpp.run platform_page_handlers : platform_page_handlers_test.cpp : $(platform) : emscripten ;
# end::page[]

# The same, built without exceptions, as a page's program may be: no
# exception may enter WebAssembly there either.
# tag::no-exceptions[]
webcpp.run platform_page_websocket_bound_no_exceptions : platform_page_websocket_bound_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
webcpp.run platform_page_websocket_late_events_no_exceptions
  : platform_page_websocket_late_events_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
webcpp.run platform_page_websocket_ingress_no_exceptions : platform_page_websocket_ingress_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
webcpp.run platform_page_websocket_tls_no_exceptions : platform_page_websocket_tls_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
webcpp.run platform_page_data_channel_no_exceptions : platform_page_data_channel_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
webcpp.run platform_page_peer_connection_no_exceptions : platform_page_peer_connection_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
webcpp.run platform_page_no_exceptions : platform_page_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
webcpp.run platform_page_sealer_allocation_no_exceptions
  : platform_page_sealer_allocation_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
webcpp.run platform_page_sealer_no_exceptions : platform_page_sealer_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
webcpp.run platform_page_relay_allocation_no_exceptions : platform_page_relay_allocation_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
webcpp.run platform_page_call_no_exceptions : platform_page_call_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
webcpp.run platform_page_handlers_no_exceptions : platform_page_handlers_test.cpp
  : $(platform) <exception-handling>off : emscripten ;
# end::no-exceptions[]

# The combined Asio/Beast/Trystero provider has its own recurring native lane.
build-project provider ;
