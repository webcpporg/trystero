{
    "boundaries": [
        {
            "headers": [
                "include/webcpp/trystero.hpp",
                "include/webcpp/trystero/*.hpp",
                "include/webcpp/trystero/protocol/*.hpp",
                "include/webcpp/trystero/detail/*.hpp"
            ],
            "must-not-include": [
                "webcpp/trystero/platform",
                "webcpp/trystero/webrtc",
                "webcpp/webrtc",
                "rtc/",
                "emscripten/",
                "openssl/"
            ],
            "why": "the core builds on both targets, without the platform backend, its WebRTC (webcpp::webrtc, natively libdatachannel), OpenSSL or Emscripten"
        }
    ]
}
